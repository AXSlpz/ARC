# ─── LLM ────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemma-3-27b-it

# ─── SEGURIDAD (OBLIGATORIAS EN PRODUCCIÓN) ──────────────────────────────────
# URL pública con HTTPS. Se usa para HSTS, CSP connect-src y validar Origin del WS.
# En red local déjalo vacío o comenta la línea para permitir http://192.168.x.x:3000
# NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# En producción con nginx (WS en el mismo dominio /ws): NEXT_PUBLIC_WS_SAME_ORIGIN=true
# NEXT_PUBLIC_WS_SAME_ORIGIN=true

# Token secreto para proteger el endpoint interno POST /broadcast del WS.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_SECRET=cambia_esto_por_un_token_aleatorio_largo

# Debe ser "production" en el servidor de producción.
# Controla: supresión del QR en stdout, nivel de logs.
# La cookie de sesión solo usa Secure si NEXT_PUBLIC_APP_URL empieza con https://
NODE_ENV=production

# Forzar cookie Secure en HTTP (solo si sabes lo que haces):
# SESSION_COOKIE_SECURE=false

# ─── WEBSOCKET ───────────────────────────────────────────────────────────────
# En producción: WS_HOST=127.0.0.1 (solo nginx). En LAN local: 0.0.0.0
# WS_PORT=3001
# WS_HOST=127.0.0.1
# NEXT_PUBLIC_WS_PORT=3001

# URL para que Next.js envíe broadcasts al WS server.
# WS_BROADCAST_URL=http://127.0.0.1:3001/broadcast

# ─── BOT ─────────────────────────────────────────────────────────────────────
REGLAMENTOS_DIR=../Reglamentos
BUSINESS_TIMEZONE=America/Mexico_City

# ─── META WHATSAPP CLOUD API (híbrido) ───────────────────────────────────────
# Con estas vars, META_LINE_ID usa Graph API (sin QR). La otra línea sigue Baileys.
# Webhook: https://tu-dominio.com/api/webhooks/meta
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=un_secreto_largo_que_inventes
# META_LINE_ID=1
# META_DISPLAY_PHONE=5215555555555
# META_GRAPH_VERSION=v21.0
