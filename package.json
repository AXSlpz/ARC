{
  "name": "agente-whatsapp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "start:bot": "tsx scripts/start-bot.ts",
    "index:reglamentos": "tsx scripts/index-reglamentos.ts",
    "test:condo-docs": "tsx --test scripts/test-condo-documents.ts",
    "test:service-schedules": "tsx --test scripts/test-service-schedules.ts",
    "test:phase3:catalog": "tsx --test scripts/test-phase3-catalog.ts",
    "test:phase3:sla": "tsx --test scripts/test-phase3-sla.ts",
    "test:phase3:signatures": "tsx --test scripts/test-phase3-signatures.ts",
    "test:phase3:fixes": "tsx --test scripts/test-phase3-fixes.ts",
    "test:phase3": "tsx --test scripts/test-phase3-catalog.ts && tsx --test scripts/test-phase3-sla.ts && tsx --test scripts/test-phase3-signatures.ts && tsx --test scripts/test-phase3-fixes.ts",
    "test:meta-webhook": "tsx scripts/test-meta-webhook.ts",
    "start:ws": "tsx scripts/ws-server.ts",
    "start:all": "concurrently --kill-others --names BOT,WEB,WS --prefix-colors yellow,cyan,magenta \"npm run start:bot\" \"npm run start\" \"npm run start:ws\"",
    "start:prod": "next start -H 127.0.0.1",
    "start:all:prod": "concurrently --kill-others --names BOT,WEB,WS --prefix-colors yellow,cyan,magenta \"npm run start:bot\" \"npm run start:prod\" \"npm run start:ws\"",
    "test:phase2:catalog": "tsx --test scripts/test-phase2-catalog.ts",
    "test:phase2:registration": "tsx --test scripts/test-phase2-registration.ts",
    "test:phase2:admin": "tsx --test scripts/test-phase2-admin.ts",
    "test:phase2": "tsx --test scripts/test-phase2-catalog.ts && tsx --test scripts/test-phase2-registration.ts && tsx --test scripts/test-phase2-admin.ts && tsx --test scripts/test-phase2-integration.ts",
    "test:phase2:integration": "tsx --test scripts/test-phase2-integration.ts",
    "test:phase3:wizard": "tsx --test scripts/test-phase3-wizard.ts",
    "test:phase3:upload-docs": "tsx --test scripts/test-phase3-upload-docs.ts",
    "test:phase3:security": "tsx --test scripts/test-phase3-security.ts",
    "test:phase4:services": "tsx --test scripts/test-phase4-services.ts",
    "test:all": "npm run test:phase2 && npm run test:phase3 && npm run test:phase3:wizard && npm run test:phase3:upload-docs && npm run test:phase3:security && npm run test:phase4:services"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/nodemailer": "^8.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "better-sqlite3": "^11.9.1",
    "concurrently": "^9.2.4",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "nodemailer": "^9.0.6",
    "openai": "^4.86.2",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "form-data": "4.0.6",
    "protobufjs": "7.6.5",
    "esbuild": "0.28.1"
  }
}
